% おちゃノート工学数学 演習PDF共通スタイル（XeLaTeX用）
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ochamath}
\RequirePackage[a4paper,margin=22mm,top=20mm,bottom=22mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{amsmath,amssymb}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage[hidelinks]{hyperref}

% ---- 日本語フォント：xeCJK があれば使い、なければ XeTeX 標準の日本語改行で組む ----
\IfFileExists{xeCJK.sty}{%
  \RequirePackage{xeCJK}%
  \IfFontExistsTF{Noto Serif CJK JP}{%
    \setCJKmainfont{Noto Serif CJK JP}\setCJKsansfont{Noto Sans CJK JP}}{%
    \setCJKmainfont{IPAexMincho}\setCJKsansfont{IPAexGothic}}%
}{%
  \IfFontExistsTF{Noto Serif CJK JP}{%
    \setmainfont{Noto Serif CJK JP}\setsansfont{Noto Sans CJK JP}}{%
    \setmainfont{IPAexMincho}\setsansfont{IPAexGothic}}%
  \XeTeXlinebreaklocale "ja"%
  \XeTeXlinebreakskip=0pt plus 1pt%
}
\linespread{1.25}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}

% ---- 色 ----
\definecolor{ink}{HTML}{1C2B44}
\definecolor{subj}{HTML}{2F5DA8}
\newcommand{\subjectcolor}[1]{\definecolor{subj}{HTML}{#1}}

% ---- メタ情報 ----
\newcommand{\sheettitle}{}\newcommand{\sheetsubject}{}\newcommand{\sheeturl}{}
\newcommand{\setsheet}[3]{\renewcommand{\sheetsubject}{#1}\renewcommand{\sheettitle}{#2}\renewcommand{\sheeturl}{#3}}

\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\sffamily\color{gray}おちゃノート工学数学　\href{https://university-math-crj.pages.dev}{university-math-crj.pages.dev}}
\fancyfoot[R]{\footnotesize\sffamily\color{gray}\thepage}

\newif\ifnameline
% 表紙ヘッダー（#1 = 問題 / 解答）
\newcommand{\makesheethead}[1]{%
  {\sffamily\color{subj}\small\textbf{\sheetsubject}\hfill #1}\par\vspace{2pt}
  {\color{subj}\rule{\linewidth}{1.2pt}}\par\vspace{4pt}
  {\sffamily\Large\bfseries\color{ink}\sheettitle}\par\vspace{2pt}
  {\sffamily\footnotesize\color{gray}解説記事：\url{\sheeturl}}\par
  \ifnameline
  \vspace{6pt}{\sffamily\small 学籍番号 \underline{\hspace{40mm}}\quad 氏名 \underline{\hspace{50mm}}}\par\fi
  \vspace{10pt}}

% ---- 問題番号 ----
\newcounter{prob}
\newcommand{\problem}[1][]{%
  \stepcounter{prob}\par\vspace{0.9em}%
  {\sffamily\bfseries\color{subj}問題 \theprob}\ifx\relax#1\relax\else\enspace{\sffamily\small\color{gray}#1}\fi\par\nobreak}
% 解答用余白
\newcommand{\workspace}[1]{\par\vspace{#1}}
% 解答側の枠
\newtcolorbox{ans}{colback=white,colframe=subj,boxrule=0.6pt,arc=0pt,left=8pt,right=8pt,top=6pt,bottom=6pt}
\newcommand{\point}[1]{\par{\sffamily\small\color{subj}\textbf{ポイント}}\quad #1\par}
\endinput
